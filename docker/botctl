#!/usr/bin/env bash
# Control an unattended bot running in the container (lib/headless.py).
#
#   docker/botctl pause      pause (no-op if already paused)
#   docker/botctl resume     resume a paused bot (no-op if running)
#   docker/botctl stop       finish the current trip, then idle
#   docker/botctl kill       stop right now (same as P), then idle
#   docker/botctl start      resume, or leave idle: log in if needed and start the bot
#   docker/botctl status     recent sessions + supervisor events
#
# Not in the docker group yet? Prefix with:  sg docker -c "docker/botctl …"
# On Windows run it from Git Bash (comes with Git for Windows).
set -euo pipefail
cd "$(dirname "$0")/.."

dc() { docker compose -f docker/docker-compose.yml "$@"; }
signal() {   # "docker compose kill" only sends the signal; its "Killed" wording is noise
    if ! running; then
        echo "the runetools container isn't running (docker compose -f docker/docker-compose.yml up -d)" >&2
        exit 1
    fi
    if dc kill -s "$1" runetools >/dev/null 2>&1; then
        echo "sent SIG$1"
    else
        echo "could not signal the bot — is the container running? (docker compose -f docker/docker-compose.yml ps)" >&2
        exit 1
    fi
}
running() { [ -n "$(dc ps --status running -q runetools 2>/dev/null)" ]; }
# The report runs inside the container when it's up (no Python needed on the
# host, e.g. Windows + Git Bash); otherwise with whatever Python the host has.
report() {
    if running; then
        dc exec -T runetools python3 -m lib.logreport "$@"
    elif [ -x .venv/bin/python ]; then .venv/bin/python -m lib.logreport "$@"
    elif [ -x .venv/Scripts/python.exe ]; then .venv/Scripts/python.exe -m lib.logreport "$@"
    elif command -v python3 >/dev/null; then python3 -m lib.logreport "$@"
    else python -m lib.logreport "$@"
    fi
}

case "${1:-}" in
    pause)        signal USR1 ;;
    resume)       signal HUP ;;
    stop)         signal USR2 ;;
    kill)         signal INT ;;
    start)        signal HUP ;;
    status)
        report sessions --last 5
        echo
        report supervisor --last 10
        ;;
    *)
        sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac
