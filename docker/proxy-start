#!/bin/sh
# Entrypoint of an account's proxy container (docker/bot.yml): Docker's eth0 becomes a
# laptop's wired NIC name (NIC_NAME, default enp0s31f6 — Intel's on a ThinkPad), then
# tun2socks' own entrypoint takes over (its tunnel tun0 on ADDR, an OpenVPN-style
# 10.8.0.2/24 in docker/bot.yml). The bot container shares this network, so that's
# what it lists as its interfaces (docker/README.md "Looking like a laptop").
set -e
IF="${NIC_NAME:-enp0s31f6}"
if [ "$IF" != eth0 ] && ip link show eth0 >/dev/null 2>&1; then
    ROUTES=$(ip -4 route show dev eth0)
    ip link set eth0 down
    ip link set eth0 name "$IF"
    ip link set "$IF" up
    # routes go with the link going down (the address stays): put them back
    echo "$ROUTES" | while read -r r; do
        # shellcheck disable=SC2086  # a route's words, as `ip route show` printed them
        [ -n "$r" ] && ip route add $r dev "$IF" 2>/dev/null || true
    done
fi
exec /entrypoint.sh
