# One account's IP and identity (docker/README.md "Accounts"). `docker/botctl new <account>`
# makes docker/accounts/<account>.env from this with a fresh MAC, hostname and VNC port;
# those files are gitignored (the proxy password lives in them).
# No other account may share PROXY, EXPECT_IP, BOT_MAC, BOT_HOSTNAME or VNC_PORT —
# `docker/botctl <account> up` refuses if one does. No comments after a value.

# the proxy every byte of this account's container goes through, from the provider's
# dashboard; URL-encode @ : / # in the password (%40 %3A %2F %23)
PROXY=socks5://USER:PASSWORD@HOST:PORT
# the IP that proxy gives you — RuneLite and Firefox won't start from any other
EXPECT_IP=fill-in-the-proxy-ip

# fixed identity: a real vendor prefix (Intel 10:F0:05) + 3 random bytes, an Ubuntu-style
# hostname — never your own card's MAC or your PC's name
BOT_MAC=10:F0:05:00:00:00
BOT_HOSTNAME=name-ThinkPad-T480
# the Linux user (default: the hostname's first part) and wired NIC name (default enp0s31f6)
#BOT_USER=name
#NIC_NAME=enp0s31f6

# this account's VNC port on 127.0.0.1 (5900, 5901, …)
VNC_PORT=5900

# unattended mode (docker/README.md "Unattended mode"); unset = manual mode
#BOT=Tanning
#LAUNCH=Black Dragonhide
#VALUE=Al Kharid

# or schedule mode (PRO-102): play the web app's schedule for this account instead —
# each block names its own bot (docker/README.md "Schedule mode")
#SCHEDULE=1
