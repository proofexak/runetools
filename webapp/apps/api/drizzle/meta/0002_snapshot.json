  "views": {
    "public.daily_activity": {
      "columns": {
        "account": {
          "name": "account",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "bot": {
          "name": "bot",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "day": {
          "name": "day",
          "type": "date",
          "primaryKey": false,
          "notNull": true
        },
        "hours": {
          "name": "hours",
          "type": "double precision",
          "primaryKey": false,
          "notNull": true
        },
        "runs": {
          "name": "runs",
          "type": "double precision",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  SELECT s.account, s.bot, d.day::date AS day,\n         sum(s.active_seconds * d.frac) / 3600 AS hours,\n         sum(s.runs * d.frac) AS runs\n  FROM sessions s\n  CROSS JOIN LATERAL (\n    SELECT g AS day,\n           CASE WHEN coalesce(s.ended_at, s.last_event_at) <= s.started_at THEN 1.0\n                ELSE extract(epoch FROM least(coalesce(s.ended_at, s.last_event_at), g + interval '1 day')\n                                        - greatest(s.started_at, g))\n                     / extract(epoch FROM coalesce(s.ended_at, s.last_event_at) - s.started_at)\n           END AS frac\n    FROM generate_series(date_trunc('day', s.started_at),\n                         date_trunc('day', coalesce(s.ended_at, s.last_event_at)),\n                         interval '1 day') AS g\n  ) d\n  WHERE d.frac > 0\n  GROUP BY s.account, s.bot, d.day\n",
      "name": "daily_activity",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
